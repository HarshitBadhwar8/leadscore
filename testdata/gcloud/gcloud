# A fake gcloud for setup/gcp.sh's tests (setup_gcp_test.go). It records every
# call in $FAKE_GCLOUD_DIR/log, one line per call, and keeps a little state in
# $FAKE_GCLOUD_DIR/state so describe and list answer as a project would:
# a file per service account, secret, secret version, bucket, repository and
# scheduler job. With FAKE_GCLOUD_READONLY set, any call that would change
# something fails, so a dry run that changes anything is caught. With
# FAKE_GCLOUD_FAIL_LIST set, listing secret versions fails (no access); with
# FAKE_GCLOUD_BUCKET_TAKEN set, creating a bucket fails (the name is taken).
set -euo pipefail
dir=${FAKE_GCLOUD_DIR:?}
state=$dir/state
mkdir -p "$state"
printf '%s\n' "$*" >>"$dir/log"

# after <flag> <args...>: the value following flag.
after() {
  local want=$1
  shift
  while (($#)); do
    if [[ $1 == "$want" ]]; then
      echo "${2:-}"
      return
    fi
    shift
  done
}
has() { [[ -e $state/$1 ]]; }
mutate() {
  if [[ -n ${FAKE_GCLOUD_READONLY:-} ]]; then
    echo "MUTATION: $*" >>"$dir/log"
    echo "fake gcloud: refusing a change in read-only mode: $*" >&2
    exit 99
  fi
}

case "$1 $2" in
  "config get-value")
    case $3 in
      account) echo "person@example.com" ;;
      project) echo "${FAKE_GCLOUD_PROJECT:-}" ;;
    esac
    ;;
  "iam service-accounts")
    case $3 in
      describe) has "sa-$4" ;;
      create) mutate "$@"; touch "$state/sa-$4@$(after --project "$@").iam.gserviceaccount.com" ;;
      *) mutate "$@" ;;
    esac
    ;;
  "storage buckets")
    case $3 in
      describe) has "bucket-${4#gs://}" ;;
      create)
        mutate "$@"
        if [[ -n ${FAKE_GCLOUD_BUCKET_TAKEN:-} ]]; then
          echo "ERROR: (gcloud.storage.buckets.create) HTTPError 409: name already taken" >&2
          exit 1
        fi
        touch "$state/bucket-${4#gs://}"
        ;;
      *) mutate "$@" ;;
    esac
    ;;
  "secrets describe") has "secret-$3" ;;
  "secrets create") mutate "$@"; touch "$state/secret-$3" ;;
  "secrets versions")
    case $3 in
      list)
        if [[ -n ${FAKE_GCLOUD_FAIL_LIST:-} ]]; then
          echo "ERROR: (gcloud.secrets.versions.list) PERMISSION_DENIED" >&2
          exit 1
        fi
        if has "version-$4"; then echo "projects/1/secrets/$4/versions/$(wc -l <"$state/version-$4" | tr -d ' ')"; fi
        ;;
      describe)
        s=$(after --secret "$@")
        has "version-$s" || exit 1
        echo "projects/1/secrets/$s/versions/$(wc -l <"$state/version-$s" | tr -d ' ')"
        ;;
      add)
        mutate "$@"
        cat >"$dir/stdin-$4"
        echo x >>"$state/version-$4"
        ;;
      *) mutate "$@" ;;
    esac
    ;;
  "artifacts repositories")
    case $3 in
      describe) has "repo-$4" ;;
      create) mutate "$@"; touch "$state/repo-$4" ;;
      *) mutate "$@" ;;
    esac
    ;;
  "scheduler jobs")
    case $3 in
      describe) has "schedjob-$4" ;;
      create) mutate "$@"; touch "$state/schedjob-$5" ;;
      *) mutate "$@" ;;
    esac
    ;;
  "run jobs")
    case $3 in
      describe) has "job-$4" ;;
      deploy) mutate "$@"; touch "$state/job-$4" ;;
      *) mutate "$@" ;;
    esac
    ;;
  "run services")
    if [[ $3 == describe ]]; then echo "https://leadscore-receiver-abc-el.a.run.app"; else mutate "$@"; fi
    ;;
  *) mutate "$@" ;;
esac
